# Gmail MCP Configuration

PORT=8000
LOG_LEVEL=INFO

# OAuth client (alternative to credentials.json)
# GOOGLE_OAUTH_CREDENTIALS=/app/credentials.json
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/oauth/callback

# Attachment size gate (bytes). Default 26214400 (25 MiB).
GMAIL_MAX_ATTACHMENT_BYTES=26214400

# Local OAuth/test UI. Docker image defaults this to 0. Set 1 only for local connect.
GMAIL_ENABLE_OAUTH_UI=1

# Optional Tool Registry (platform)
# TOOL_REGISTRY_BASE_URL=http://datumbridge-mcp:8081/api/v1
# TOOL_REGISTRY_API_KEY=
